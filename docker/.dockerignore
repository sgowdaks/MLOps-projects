# .dockerignore — prevents these paths from being sent to the Docker build context.
# A smaller build context = faster builds and no risk of leaking secrets.

# Python cache / bytecode
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Virtual environments
.venv/
venv/
env/

# Test & coverage artifacts
.pytest_cache/
.coverage
htmlcov/

# Editor / OS metadata
.vscode/
.idea/
*.DS_Store
Thumbs.db

# Git history (not needed inside image)
.git/
.gitignore

# CI/CD config
.github/

# Secrets / env files — never bake these into an image
.env
*.env
secrets/
